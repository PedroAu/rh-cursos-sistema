# Roteamento para Next.js static export com trailingSlash: true.
# Cada rota gera uma pasta com index.html (login/index.html, cursos/<slug>/index.html),
# que o Apache serve nativamente — sem listagem de diretório.
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Arquivos e diretórios reais servidos diretamente (assets, _next/, pastas com index.html)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Tenta servir /rota.html (compat com qualquer arquivo flat remanescente)
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]

  # Fallback: página 404 do Next
  RewriteRule ^ /404.html [L]
</IfModule>
