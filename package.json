{
  "name": "rh-cursos",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cloudflare": "opennextjs-cloudflare build && node scripts/strip-secrets-from-bundle.mjs",
    "start": "wrangler dev",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "deploy:check": "npm run lint && npm run typecheck && npm run test && npm run build:cloudflare",
    "deploy:cloudflare": "opennextjs-cloudflare deploy",
    "deploy:workers": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "preview:cloudflare": "npm run build:cloudflare && wrangler dev",
    "verify:workers": "node scripts/verify-workers-deploy.js",
    "security:secrets": "node scripts/check-secret-hygiene.mjs",
    "test": "node ./scripts/run-vitest.mjs run",
    "test:watch": "node ./scripts/run-vitest.mjs",
    "test:e2e": "playwright test",
    "test:e2e:env": "node scripts/verify-e2e-environment.mjs",
    "sync:skills:codex": "node .aiox-core/infrastructure/scripts/codex-skills-sync/bootstrap.js",
    "sync:skills:codex:check": "node .aiox-core/infrastructure/scripts/codex-skills-sync/bootstrap.js --dry-run",
    "sync:skills:codex:global": "node .aiox-core/infrastructure/scripts/codex-skills-sync/bootstrap.js --skills-dir \"$HOME/.codex/skills\"",
    "setup:codex-skills": "npm run sync:skills:codex",
    "setup:codex-skills:dry": "npm run sync:skills:codex:check"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.19.11",
    "@radix-ui/react-accordion": "^1.2.14",
    "@radix-ui/react-alert-dialog": "^1.1.17",
    "@radix-ui/react-checkbox": "^1.3.5",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-progress": "^1.1.10",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-separator": "^1.1.10",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.1",
    "@radix-ui/react-tabs": "^1.1.15",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.1",
    "@tabler/icons-react": "^3.44.0",
    "@tailwindcss/postcss": "^4.3.1",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.20.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.61.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jsdom": "^29.1.1",
    "typescript": "^5",
    "vitest": "^4.1.8",
    "wrangler": "^4.102.0"
  }
}
