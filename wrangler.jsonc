{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "site-rh-cursos",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://www.rhcursos.com.br",
    "NEXT_PUBLIC_SUPABASE_URL": "https://hwpsrujkxjhmmwphqdlz.supabase.co",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_OHCSE9S7HlY-lckwL0-2NA_mjGg81C5",
    "ASAAS_ENVIRONMENT": "production",
    "ASAAS_CHECKOUT_EXPIRES_MINUTES": "30",
    "ASAAS_12X_INTEREST_FREE_CONFIRMED": "false"
  },
  "routes": [
    {
      "pattern": "www.rhcursos.com.br/*",
      "zone_name": "rhcursos.com.br"
    },
    {
      "pattern": "rhcursos.com.br/*",
      "zone_name": "rhcursos.com.br"
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
