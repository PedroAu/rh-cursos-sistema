# ============================================
# RH Cursos Environment Configuration
# ============================================
# SECURITY: Never commit sensitive credentials to version control
#
# MODELO DE AMBIENTES (importante — leia antes de copiar):
#
#   Desenvolvimento local  -> runtime padrao do projeto: Node.js + Next.js + React.
#                             Copie este arquivo para `.env.local` e rode `npm run dev`.
#                             Aponte para um projeto Supabase de TESTE. NUNCA use
#                             credenciais de producao no dev local.
#
#   Produção               -> configure as variáveis no provedor de build do
#                             frontend e nos secrets do Supabase/GitHub Actions
#                             quando aplicável.
#
# Para validar o bundle de publicação localmente antes de subir: `npm run preview:static`

# ============================================
# Authentication & Security
# ============================================

# SESSION_SECRET for auth cookie signing (required in production)
# Must be at least 32 characters. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SESSION_SECRET=your-32-char-secret-key-here-generate-a-secure-one

# ============================================
# Demo Authentication Feature Flag
# ============================================
# SECURITY: Demo auth is DISABLED by default and only available in development
#
# Feature Flag: NEXT_PUBLIC_ENABLE_DEMO_AUTH
#   - true  = demo auth enabled (development only, never set in production)
#   - false = demo auth disabled (RECOMMENDED DEFAULT)
#
# To enable demo auth during local development:
#   1. Copy this file to .env.local
#   2. Set NEXT_PUBLIC_ENABLE_DEMO_AUTH=true
#   3. Optionally set DEMO_ADMIN_PASSWORD to override default (admin123)
#   4. Run `npm run dev`
#   5. Login with: admin@rhcursos.demo / admin123 (or your custom password)
#
# WARNING: Never enable in production. This will trigger critical security warnings.

NEXT_PUBLIC_ENABLE_DEMO_AUTH=false

# Demo admin password (optional override, only used if NEXT_PUBLIC_ENABLE_DEMO_AUTH=true)
# Default: admin123
# DEMO_ADMIN_PASSWORD=your-custom-demo-password

# ============================================
# Supabase Configuration
# ============================================
# Get these from: Supabase Dashboard > Project Settings > API

# Public API URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public Anon Key (safe to expose in frontend)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example.key

# Edge Functions base URL (modelo híbrido). Opcional — por padrão é derivado de
# NEXT_PUBLIC_SUPABASE_URL como `${url}/functions/v1`. Defina apenas se usar
# domínio custom para as functions.
# NEXT_PUBLIC_SUPABASE_FUNCTIONS_URL=https://your-project-ref.supabase.co/functions/v1

# Service Role Key (SECRET - never expose in frontend)
# No modelo híbrido o runtime das Edge Functions injeta esta chave automaticamente;
# mantida aqui apenas para scripts/migrations locais.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example.key

# Database URL (SECRET)
# Format: postgresql://postgres:password@host:5432/postgres
SUPABASE_DB_URL=postgresql://postgres:your-secure-password@db.your-project-ref.supabase.co:5432/postgres

# Direct database URL for migrations (if different from above)
SUPABASE_URL=https://your-project-ref.supabase.co

# ============================================
# Application Configuration
# ============================================

NODE_ENV=development

# Public app URL (used for CORS, redirects, etc)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# Analytics (EP-1.3 — Google Analytics 4)
# ============================================
# Measurement ID da propriedade GA4 (formato G-XXXXXXXXXX). OPCIONAL.
# Sem este valor o GA4 fica inativo (no-op): nenhum script é injetado e
# trackEvent() não faz nada. Em produção, defina via secret do Cloudflare:
#   wrangler secret put NEXT_PUBLIC_GA_MEASUREMENT_ID   (ou no painel do Worker)
# O ID é público por natureza (vai no bundle do cliente).
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
